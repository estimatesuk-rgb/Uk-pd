{
  "name": "mitchell-proctor-fees",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "triggers": {"crons": ["0 9 * * MON-FRI"]},
  "durable_objects": {
    "bindings": [
      {
        "name": "MP_DATA",
        "class_name": "MpSqlStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MpSqlStore"
      ]
    }
  ]
}
